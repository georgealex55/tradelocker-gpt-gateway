# TradeLocker connection
TRADELOCKER_ENV=live
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_ACC_NUM=

# Optional explicit account lock.
# If blank/omitted, TRADELOCKER_ACCOUNT_ID is used automatically.
EXPECTED_ACCOUNT_ID=

# Durable trade state (Neon/Postgres)
# Apply db/migrations/001_trade_state.sql before enabling.
DATABASE_URL=
TRADE_STATE_DB_ENABLED=true

# Execution controls
TRADING_ENABLED=false
KILL_SWITCH=true
TRADE_APPROVAL_KEY=

# Initial risk controls
ACCOUNT_CURRENCY=USD
ALLOWED_SYMBOLS=USDCHF
MAX_LOTS_PER_TRADE=0.01
MAX_ORDER_UNITS=1000
REQUIRE_STOP_LOSS=true
REQUIRE_TAKE_PROFIT=true
MIN_RISK_REWARD=1.5
MAX_RISK_PERCENT=27
STRICT_RISK_PERCENT_CHECK=true
MAX_SPREAD_PIPS=3
MAX_SPREAD_AS_STOP_FRACTION=0.2
STRICT_QUOTE_CHECK=true
MAX_OPEN_POSITIONS=1
MAX_PENDING_ORDERS=1
MAX_DAILY_TRADES=2

# Duplicate-order protection
IDEMPOTENCY_REQUIRED=true
DEDUPE_LOOKBACK_HOURS=168

# Stale market-data protection
STALE_QUOTE_GUARD=true
STRICT_STALE_QUOTE_CHECK=true
MAX_MARKET_DATA_AGE_MS=180000
MARKET_FRESHNESS_LOOKBACK_MS=900000

# Post-trade verification
VERIFY_LOOKBACK_HOURS=168

# Vercel cron authentication (required in production)
CRON_SECRET=
